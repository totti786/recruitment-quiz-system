# Production env for testlab — copy to .env.production and fill secrets
# Never commit the filled file.
DATABASE_URL="file:/app/data/quiz.db"
JWT_SECRET="REPLACE-WITH-openssl-rand-base64-32"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="REPLACE-WITH-STRONG-PASSWORD"
PORT=3001
CORS_ORIGIN="https://quiz.testlab.local,https://control.testlab.local,http://10.11.204.9:3001"
# Optional: change quiz token expiry, rate limits — keep defaults otherwise
