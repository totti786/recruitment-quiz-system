[Unit]
Description=Quiz deploy webhook (GitLab -> control)
After=docker.service
Requires=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/quiz-webhook/quiz-webhook.py 9000
Restart=always
RestartSec=5
# secret + repo must be readable; docker needs root
User=root

[Install]
WantedBy=multi-user.target
